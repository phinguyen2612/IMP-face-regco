{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:face-recognition:model-manifest:v1",
  "type": "object",
  "required": ["schema_version", "model_type", "inputs", "outputs", "preprocessing", "metadata"],
  "properties": {
    "schema_version": { "const": 1 },
    "model_type": { "enum": ["PERSON_DETECTOR", "FACE_DETECTOR", "FACE_EMBEDDER"] },
    "inputs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/tensor" } },
    "outputs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/tensor" } },
    "preprocessing": {
      "type": "object",
      "required": ["layout", "color_order", "normalization", "resize_mode"],
      "properties": {
        "layout": { "enum": ["NCHW", "NHWC"] },
        "color_order": { "enum": ["RGB", "BGR"] },
        "normalization": { "type": "string", "minLength": 1 },
        "resize_mode": { "enum": ["letterbox", "stretch", "aligned"] }
      },
      "additionalProperties": false
    },
    "metadata": { "type": "object" },
    "runtime_compatibility": {
      "type": "array",
      "items": { "enum": ["AUTO", "ONNX_CPU", "ONNX_CUDA", "TENSORRT"] },
      "default": ["ONNX_CPU"]
    }
  },
  "$defs": {
    "tensor": {
      "type": "object",
      "required": ["name", "shape", "dtype"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "shape": { "type": "array", "minItems": 1, "items": { "type": ["integer", "string"] } },
        "dtype": { "enum": ["float32", "float16", "uint8", "int64"] }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}